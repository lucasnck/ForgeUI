{
  "name": "forge-ui-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "web/library",
    "showcase/portal"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @forge-ui/showcase",
    "build": "npm run build --workspace @forge-ui/showcase",
    "typecheck": "npm run typecheck --workspace @forge-ui/web && npm run typecheck --workspace @forge-ui/showcase",
    "check": "npm run test:migrate:bulk && npm run test:showcase-store && npm run verify:workspace && npm run verify:v2 && npm run coverage && npm run verify:docs && npm run verify:phase6 && npm run audit:bulk:targets && npm run typecheck && npm run build && npm run check:cross-platform",
    "verify:workspace": "node scripts/verify-workspace.mjs",
    "test:showcase-store": "node scripts/test-example-store.mjs",
    "verify:v2": "node scripts/test-v2-contracts.mjs",
    "coverage": "node scripts/generate-migration-coverage.mjs",
    "verify:phase6": "node scripts/test-phase6-contracts.mjs",
    "verify:docs": "node scripts/verify-sc-manifests.mjs && node scripts/audit-sc-links.mjs",
    "migrate:bulk": "node scripts/migrate-from-praticarfront.mjs --apply",
    "audit:migrate:bulk": "node scripts/migrate-from-praticarfront.mjs",
    "test:migrate:bulk": "node scripts/test-bulk-migration.mjs",
    "audit:bulk": "node scripts/audit-bulk-migration.mjs",
    "audit:bulk:targets": "node scripts/audit-bulk-migration.mjs --target-only",
    "tokens:generate": "node shared/tokens/generate.mjs && node scripts/generate-flutter-motion.mjs",
    "tokens:check": "node scripts/check-token-parity.mjs && node scripts/generate-flutter-motion.mjs --check",
    "build:flutter-preview": "node scripts/build-flutter-preview.mjs",
    "check:cross-platform": "npm run tokens:check && npm run check:showcase-parity && npm run audit:flutter-parity && npm run test:showcase-parity-shell && npm run test:dart-code-display && npm run check:flutter-format && npm run test:flutter-preview && npm run test:independence && npm run audit:independence && npm run test:native-typography && npm run test:native-link-progress && npm run test:native-import-only && npm run test:native-surfaces && npm run test:native-checkables && npm run test:native-actions && npm run test:native-independence && npm run audit:native-independence && npm run test:native-slider && npm run test:native-showcase-shell",
    "test:flutter-preview": "node scripts/test-flutter-preview.mjs",
    "audit:flutter-source": "node scripts/audit-flutter-components.mjs",
    "catalog:flutter-api": "node scripts/generate-flutter-api.mjs && node scripts/generate-flutter-catalog.mjs",
    "check:flutter-api": "node scripts/generate-flutter-catalog.mjs --check",
    "catalog:flutter-primitives": "node scripts/generate-flutter-primitives.mjs",
    "test:flutter-catalog": "node scripts/test-flutter-catalog.mjs",
    "catalog:flutter-interactions": "node scripts/generate-flutter-interactions.mjs",
    "catalog:flutter-forms": "node scripts/generate-flutter-forms.mjs",
    "test:flutter-interactions": "node scripts/test-flutter-interaction-catalog.mjs",
    "test:flutter-forms": "node scripts/test-flutter-form-catalog.mjs",
    "catalog:flutter-collections": "node scripts/generate-flutter-collections.mjs",
    "test:flutter-collections": "node scripts/test-flutter-collection-catalog.mjs",
    "catalog:flutter-transients": "node scripts/generate-flutter-transients.mjs",
    "test:flutter-transients": "node scripts/test-flutter-transient-catalog.mjs",
    "catalog:flutter-advanced": "node scripts/generate-flutter-advanced.mjs",
    "test:flutter-advanced": "node scripts/test-flutter-advanced-catalog.mjs",
    "catalog:flutter-parts": "node scripts/generate-flutter-parts.mjs",
    "test:flutter-parts": "node scripts/test-flutter-part-catalog.mjs",
    "test:flutter-http": "node scripts/test-flutter-http.mjs",
    "check:showcase-parity": "node scripts/check-showcase-parity.mjs",
    "check:flutter-format": "dart format --output=none --set-exit-if-changed app/library/lib/src/components/forge_tabs.dart app/showcase_flutter/lib/main.dart",
    "audit:flutter-parity": "node scripts/audit-flutter-react-parity.mjs --check",
    "report:flutter-parity": "node scripts/audit-flutter-react-parity.mjs --write-report",
    "test:dart-code-display": "node scripts/test-flutter-code-display.mjs",
    "check:flutter-format-all": "dart format --output=none --set-exit-if-changed app/library/lib app/library/test app/showcase_flutter/lib app/showcase_flutter/test",
    "test:showcase-parity-shell": "node scripts/test-showcase-parity-shell.mjs",
    "audit:independence": "node scripts/audit-runtime-independence.mjs --check --write-report",
    "audit:independence:strict": "node scripts/audit-runtime-independence.mjs --check --strict",
    "test:independence": "node scripts/test-runtime-independence.mjs",
    "test:native-typography": "node scripts/check-native-typography.mjs",
    "test:native-link-progress": "node scripts/check-native-link-progress.mjs && node scripts/test-native-link-progress.mjs",
    "test:native-import-only": "node scripts/check-import-only-wave.mjs",
    "test:native-surfaces": "node scripts/check-native-surfaces.mjs",
    "test:native-checkables": "node scripts/check-native-checkables.mjs && node scripts/test-native-checkables.mjs",
    "test:native-actions": "node scripts/check-native-actions.mjs && node scripts/test-native-actions.mjs",
    "audit:native-independence": "node scripts/audit-native-independence.mjs --check --max-platform-imports=6 --write-report",
    "audit:native-independence:strict": "node scripts/audit-native-independence.mjs --check --strict",
    "test:native-independence": "node scripts/test-native-independence.mjs",
    "test:native-slider": "node scripts/check-native-slider.mjs && node scripts/test-native-slider.mjs",
    "test:native-showcase-shell": "node scripts/check-native-showcase-shell.mjs && node scripts/test-native-showcase-shell.mjs"
  }
}
