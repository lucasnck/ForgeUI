{
  "name": "forge-ui-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "web/library",
    "showcase/portal"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @forge-ui/showcase",
    "build": "npm run build --workspace @forge-ui/showcase",
    "typecheck": "npm run typecheck --workspace @forge-ui/web && npm run typecheck --workspace @forge-ui/showcase",
    "check": "npm run test:migrate:bulk && npm run test:showcase-store && npm run verify:workspace && npm run verify:v2 && npm run coverage && npm run verify:docs && npm run verify:phase6 && npm run audit:bulk:targets && npm run typecheck && npm run build && npm run check:cross-platform",
    "verify:workspace": "node scripts/verify-workspace.mjs",
    "test:showcase-store": "node scripts/test-example-store.mjs",
    "verify:v2": "node scripts/test-v2-contracts.mjs",
    "coverage": "node scripts/generate-migration-coverage.mjs",
    "verify:phase6": "node scripts/test-phase6-contracts.mjs",
    "verify:docs": "node scripts/verify-sc-manifests.mjs && node scripts/audit-sc-links.mjs",
    "migrate:bulk": "node scripts/migrate-from-praticarfront.mjs --apply",
    "audit:migrate:bulk": "node scripts/migrate-from-praticarfront.mjs",
    "test:migrate:bulk": "node scripts/test-bulk-migration.mjs",
    "audit:bulk": "node scripts/audit-bulk-migration.mjs",
    "audit:bulk:targets": "node scripts/audit-bulk-migration.mjs --target-only",
    "tokens:generate": "node shared/tokens/generate.mjs",
    "tokens:check": "node scripts/check-token-parity.mjs",
    "build:flutter-preview": "node scripts/build-flutter-preview.mjs",
    "check:cross-platform": "npm run tokens:check && npm run test:flutter-preview",
    "test:flutter-preview": "node scripts/test-flutter-preview.mjs",
    "audit:flutter-source": "node scripts/audit-flutter-components.mjs",
    "catalog:flutter-api": "node scripts/generate-flutter-api.mjs && node scripts/generate-flutter-catalog.mjs",
    "check:flutter-api": "node scripts/generate-flutter-catalog.mjs --check",
    "catalog:flutter-primitives": "node scripts/generate-flutter-primitives.mjs",
    "test:flutter-catalog": "node scripts/test-flutter-catalog.mjs"
  }
}
